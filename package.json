{
  "name": "bmb-token",
  "version": "1.0.0",
  "private": true,
  "description": "BMB ERC-20 token for Polygon PoS",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:amoy": "hardhat ignition deploy ignition/modules/BMB.ts --network polygonAmoy",
    "deploy:polygon": "hardhat ignition deploy ignition/modules/BMB.ts --network polygon",
    "verify:polygon": "hardhat verify --network polygon"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@types/node": "^24.5.2",
    "hardhat": "3.18.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}